{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open HASE Lab",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "py"
      },
      "args": [
        "-B",
        "serve.py",
        "--open"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
